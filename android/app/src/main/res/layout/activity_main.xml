<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_horizontal">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/music_sync"
        android:textSize="28sp"
        android:textStyle="bold"
        android:layout_marginTop="32dp"
        android:layout_marginBottom="32dp" />

    <TextView
        android:id="@+id/tvQueueStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/queue_0_pending"
        android:textSize="18sp"
        android:gravity="center"
        android:padding="16dp"
        android:background="#EEEEEE"
        android:layout_marginBottom="16dp"/>

    <Button
        android:id="@+id/btnViewQueue"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/manage_offline_queue" />

    <Button
        android:id="@+id/btnViewHistory"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/view_sync_history"
        android:layout_marginTop="8dp"/>

    <Button
        android:id="@+id/btnSettings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/settings"
        android:layout_marginTop="32dp"
        style="@style/Widget.Material3.Button.OutlinedButton" />

    <Button
        android:id="@+id/btnSyncNow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/force_sync_queue_now"
        android:layout_marginTop="32dp"
        android:backgroundTint="#4CAF50"
        android:textColor="#FFFFFF"/>

</LinearLayout>